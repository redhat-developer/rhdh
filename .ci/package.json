{
  "name": ".ci",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "scripts": {
    "shellcheck": "git ls-files -z '*.sh' | xargs -0 shellcheck --severity=warning --color=always",
    "prettier:check": "prettier --check \"**/*.{sh,md,yaml,yml}\"",
    "prettier:fix": "prettier --write \"**/*.{sh,md,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-sh": "0.19.0",
    "shellcheck": "4.1.0"
  },
  "packageManager": "yarn@4.19.0"
}
