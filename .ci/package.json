{
  "name": ".ci",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "scripts": {
    "shellcheck": "git ls-files -z '*.sh' | xargs -0 shellcheck --severity=warning --color=always",
    "fmt": "oxfmt '**/*.{md,yaml,yml}' && node scripts/format-sh.mjs --write",
    "fmt:check": "oxfmt --check '**/*.{md,yaml,yml}' && node scripts/format-sh.mjs --check"
  },
  "devDependencies": {
    "@wasm-fmt/shfmt": "0.2.7",
    "editorconfig": "4.0.1",
    "oxfmt": "0.67.0",
    "shellcheck": "4.1.0"
  },
  "packageManager": "yarn@4.19.0"
}
