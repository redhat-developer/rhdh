{
  "name": "backend",
  "version": "1.0.1",
  "main": "dist/index.cjs.js",
  "types": "src/index.ts",
  "private": true,
  "backstage": {
    "role": "backend"
  },
  "scripts": {
    "start": "backstage-cli package start --require ./src/instrumentation.js",
    "start:prometheus": "docker run --mount type=bind,source=./prometheus.yml,destination=/etc/prometheus/prometheus.yml --publish published=9090,target=9090,protocol=tcp prom/prometheus",
    "build": "backstage-cli package build",
    "lint:check": "backstage-cli package lint",
    "lint:fix": "backstage-cli package lint --fix",
    "test": "backstage-cli package test --passWithNoTests --coverage",
    "clean": "backstage-cli package clean",
    "tsc": "tsc",
    "prettier:check": "prettier --ignore-unknown --check .",
    "prettier:fix": "prettier --ignore-unknown --write ."
  },
  "dependencies": {
    "@backstage-community/plugin-rbac-backend": "8.1.4",
    "@backstage-community/plugin-rbac-node": "2.1.1",
    "@backstage-community/plugin-scaffolder-backend-module-annotator": "2.20.0",
    "@backstage/backend-app-api": "1.8.0",
    "@backstage/backend-defaults": "0.18.1",
    "@backstage/backend-dynamic-feature-service": "0.8.8",
    "@backstage/backend-plugin-api": "1.11.0",
    "@backstage/catalog-client": "1.16.3",
    "@backstage/catalog-model": "1.10.2",
    "@backstage/cli-node": "0.3.5",
    "@backstage/config": "1.3.10",
    "@backstage/plugin-app-backend": "0.5.19",
    "@backstage/plugin-auth-backend": "0.30.2",
    "@backstage/plugin-auth-backend-module-github-provider": "0.5.8",
    "@backstage/plugin-auth-backend-module-guest-provider": "0.2.24",
    "@backstage/plugin-auth-node": "0.7.7",
    "@backstage/plugin-catalog-backend": "4.0.2",
    "@backstage/plugin-catalog-backend-module-logs": "0.1.27",
    "@backstage/plugin-catalog-backend-module-openapi": "0.2.27",
    "@backstage/plugin-catalog-backend-module-scaffolder-entity-model": "0.2.25",
    "@backstage/plugin-events-backend": "0.6.7",
    "@backstage/plugin-events-node": "0.4.27",
    "@backstage/plugin-permission-backend": "0.7.17",
    "@backstage/plugin-proxy-backend": "0.6.19",
    "@backstage/plugin-scaffolder-backend": "4.2.1",
    "@backstage/plugin-search-backend": "2.1.8",
    "@backstage/plugin-search-backend-module-catalog": "0.3.20",
    "@backstage/plugin-search-backend-module-pg": "0.5.60",
    "@backstage/plugin-user-settings-backend": "0.4.8",
    "@internal/plugin-dynamic-plugins-info-backend": "workspace:*",
    "@internal/plugin-licensed-users-info-backend": "workspace:*",
    "@module-federation/sdk": "2.3.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/exporter-prometheus": "0.218.0",
    "@opentelemetry/host-metrics": "0.38.3",
    "@opentelemetry/instrumentation-runtime-node": "0.30.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@red-hat-developer-hub/backstage-plugin-translations-backend": "0.6.0",
    "@red-hat-developer-hub/cli-module-install-dynamic-plugins": "0.6.1",
    "app": "workspace:*",
    "better-sqlite3": "13.0.3",
    "express": "4.22.3",
    "global-agent": "3.0.0",
    "mongodb": "7.6.0",
    "undici": "7.29.1",
    "winston": "3.14.2"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "1.11.8",
    "@backstage/cli": "0.36.7",
    "@backstage/cli-defaults": "0.1.7",
    "@backstage/plugin-catalog-node": "2.2.6",
    "@backstage/types": "1.2.2",
    "@types/express": "4.17.25",
    "@types/global-agent": "2.1.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}
