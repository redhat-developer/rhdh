{
  "name": "backstage-plugin-notifications",
  "version": "0.5.20",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "backstage": {
    "role": "frontend-plugin",
    "supported-versions": "1.54.4",
    "pluginId": "notifications",
    "pluginPackages": [
      "backstage-plugin-notifications",
      "backstage-plugin-notifications-backend"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "tsc": "tsc",
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint:check": "backstage-cli package lint",
    "test": "backstage-cli package test --passWithNoTests --coverage",
    "export-dynamic": "janus-cli package export-dynamic-plugin --in-place",
    "export-dynamic:clean": "run export-dynamic --clean"
  },
  "dependencies": {
    "@backstage/core-plugin-api": "1.12.9",
    "@backstage/plugin-notifications": "0.5.20",
    "@mui/material": "5.18.0"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.5",
    "@backstage/cli-defaults": "0.1.5",
    "@janus-idp/cli": "3.7.0",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "dist-scalprum"
  ],
  "scalprum": {
    "name": "backstage.plugin-notifications",
    "exposedModules": {
      "PluginRoot": "./src/index.ts",
      "Alpha": "./src/alpha.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/rhdh",
    "directory": "dynamic-plugins/wrappers/backstage-plugin-notifications"
  },
  "maintainers": [
    "@janus-idp/maintainers-showcase"
  ],
  "author": "Red Hat",
  "homepage": "https://red.ht/rhdh",
  "bugs": "https://github.com/backstage/backstage/issues",
  "keywords": [
    "support:tech-preview",
    "lifecycle:active"
  ]
}
